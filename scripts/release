#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: scripts/release [auto|patch|minor|major|X.Y.Z] [--dry-run] [-y]" >&2
  exit 64
}

die() {
  echo "release: $*" >&2
  exit 1
}

cd "$(git rev-parse --show-toplevel)"
source scripts/version.sh

kind=auto
dry_run=0
assume_yes=0
for arg in "$@"; do
  case $arg in
    --dry-run) dry_run=1 ;;
    -y) assume_yes=1 ;;
    -h | --help) usage ;;
    -*) usage ;;
    *) kind=$arg ;;
  esac
done

preflight() {
  if ((dry_run)); then
    echo "release: $* (a real release would stop here)" >&2
  else
    die "$*"
  fi
}

[[ $(git branch --show-current) == main ]] || preflight "not on main"
[[ -z $(git status --porcelain) ]] || preflight "the working tree isn't clean"
if git remote get-url origin >/dev/null 2>&1; then
  git fetch --quiet --tags origin main
  [[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || preflight "HEAD isn't in sync with origin/main"
fi

last_tag=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)
range=HEAD
[[ -n $last_tag ]] && range=$last_tag..HEAD
subjects=$(git log --format=%s "$range")
bodies=$(git log --format=%B "$range")

computed=
if grep -qE '^[a-z]+(\([^)]*\))?!:' <<<"$subjects" || grep -q '^BREAKING CHANGE:' <<<"$bodies"; then
  computed=major
elif grep -qE '^feat(\(|:)' <<<"$subjects"; then
  computed=minor
elif grep -qE '^(fix|perf|revert)(\(|:)' <<<"$subjects"; then
  computed=patch
fi

current=$(read_version)
IFS=. read -r major minor patch <<<"${current%%-*}"

bump=$kind
if [[ $kind == auto ]]; then
  [[ -n $computed ]] || die "nothing to release since ${last_tag:-the first commit}: no feat, fix, perf, revert or breaking commits"
  bump=$computed
  if [[ $bump == major && $major == 0 ]]; then
    bump=minor
  fi
fi

case $bump in
  major) next=$((major + 1)).0.0 ;;
  minor) next=$major.$((minor + 1)).0 ;;
  patch) next=$major.$minor.$((patch + 1)) ;;
  [0-9]*.[0-9]*.[0-9]*) next=$bump ;;
  *) usage ;;
esac

git rev-parse -q --verify "refs/tags/v$next" >/dev/null && die "v$next already exists"
[[ $(printf '%s\n%s\n' "${current%%-*}" "$next" | sort -V | head -1) == "${current%%-*}" ]] ||
  die "$next is lower than the current version, $current"

unreleased=$(awk '/^## \[Unreleased\]/ { on = 1; next } /^## \[/ { on = 0 } on' CHANGELOG.md)
if [[ -n $computed ]]; then
  grep -q '^- ' <<<"$unreleased" || die "CHANGELOG.md has nothing under [Unreleased]; run /pk-changelog or add the lines by hand"
fi

echo "$current -> $next ($bump${computed:+, commits say $computed})"
echo
git log --format='  %s' "$range"
echo
echo "Changelog:"
sed 's/^/  /' <<<"$unreleased"
echo

if ((dry_run)); then
  echo "Dry run: nothing changed."
  exit 0
fi

if ((!assume_yes)); then
  [[ -t 0 ]] || die "no terminal to confirm in: rerun with -y"
  read -r -p "Release v$next? [y/N] " answer
  [[ $answer == [yY] ]] || die "stopped"
fi

today=$(date +%F)
awk -v heading="## [$next] - $today" '
  /^## \[Unreleased\]/ && !done { print; print ""; print heading; done = 1; next }
  { print }
' CHANGELOG.md >CHANGELOG.md.tmp
mv CHANGELOG.md.tmp CHANGELOG.md

write_version "$next"

git add -A
git commit --quiet -m "chore(Release): $next"
git tag -a "v$next" -m "$next"

if git remote get-url origin >/dev/null 2>&1; then
  git push --quiet --atomic origin main "v$next"
  echo "Pushed v$next. The release workflow takes it from here."
else
  echo "Tagged v$next. No origin remote, so nothing was pushed."
fi
