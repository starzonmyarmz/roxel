#!/usr/bin/env bash
# Block push if clippy warns or `cargo test` fails. Skip with `git push --no-verify`.
# Mirrors the CI clippy + test gates so lint drift fails locally first.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: cargo clippy -D warnings"
cargo clippy --all-targets --no-deps -- -D warnings
echo "pre-push: cargo test"
cargo test --quiet
