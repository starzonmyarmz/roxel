#!/usr/bin/env bash
# Prepend the commit subject as a bullet under `## [Unreleased]` in
# CHANGELOG.md, then re-stage the file so the entry lands in this commit.
#
# Skipped for merge / squash / amend commits to avoid duplicate or stale
# entries. Bypass with `git commit --no-verify`.

set -e

MSG_FILE="$1"
SOURCE="${2:-}"

case "$SOURCE" in
    merge|squash|commit) exit 0 ;;
esac

REPO="$(git rev-parse --show-toplevel)"
CHANGELOG="$REPO/CHANGELOG.md"
[ -f "$CHANGELOG" ] || exit 0

# First non-comment, non-blank line of the message is the subject.
SUBJECT="$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1)"
[ -n "$SUBJECT" ] || exit 0

# Skip if this exact subject is already the most recent Unreleased bullet
# (defensive: catches edge cases like reruns of prepare-commit-msg).
if awk '
    /^## \[Unreleased\]/ { in_un = 1; next }
    in_un && /^## / { exit }
    in_un && /^- / { print; exit }
' "$CHANGELOG" | grep -qxF -- "- $SUBJECT"; then
    exit 0
fi

awk -v entry="- $SUBJECT" '
    !inserted && /^## \[Unreleased\]/ {
        print
        # Consume any blank lines immediately following the header.
        getline next_line
        while (next_line ~ /^[[:space:]]*$/) {
            print next_line
            if ((getline next_line) <= 0) { next_line = ""; break }
        }
        print entry
        print next_line
        inserted = 1
        next
    }
    { print }
    END {
        if (!inserted) {
            print ""
            print "## [Unreleased]"
            print ""
            print entry
        }
    }
' "$CHANGELOG" > "$CHANGELOG.tmp"

mv "$CHANGELOG.tmp" "$CHANGELOG"
git add "$CHANGELOG"
